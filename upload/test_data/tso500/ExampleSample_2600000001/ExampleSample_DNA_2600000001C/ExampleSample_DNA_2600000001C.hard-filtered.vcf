##DRAGENCommandLine=<ID=dragen,Version="SW: 07.021.624.3.11.2, HW: 07.021.624",Date="Thu Jan 01 12:23:42 UTC 2026",CommandLineOptions="--ref-dir hashtable --output-directory DnaDragenCaller --output-file-prefix ExampleSample_DNA_2600000001C --events-log-file events.csv --tso500-solid-umi true --umi-metrics-interval-file resource_bundle/small_variants/TSO_HRD_manifest_randomized.bed --tso500-solid-snv true --vc-sq-call-threshold=-1 --vc-target-bed resource_bundle/small_variants/TST500C_manifest.bed --vc-target-bed-padding 8 --vc-systematic-noise resource_bundle/small_variants/mean_gvcf_bq30_lowSQ_v1.0_systematic_noise_v2_novaseqx.bed.gz --vc-depth-annotation-threshold 100 --vc-homref-depth-filter-threshold 100 --tumor-fastq-list ExampleSample_DNA_2600000001C.fastq_list.csv --tumor-fastq-list-sample-id ExampleSample_DNA_2600000001C --vc-somatic-hotspots resource_bundle/small_variants/pepe2_prior.vcf --vc-hotspot-log10-prior-boost 3.0 --vc-blacklist-bed resource_bundle/small_variants/pepe_blacklist_sorted.bed --qc-coverage-ignore-overlaps true --gc-metrics-enable true --qc-coverage-region-1 resource_bundle/small_variants/TST500C_CodingRegions_hg19.bed --qc-coverage-reports-1 callability --qc-coverage-tag-1 tmb --qc-coverage-region-2 resource_bundle/small_variants/TST500C_manifest.exon.bed --qc-coverage-tag-2 exon --qc-coverage-reports-2 cov_report --tso500-contam-vcf resource_bundle/contamination/Contamination.vcf --qc-contam-min-basequal 30 --qc-contam-min-mapq 30 --tso500-solid-cnv true --cnv-combined-counts resource_bundle/cnv/TSO500_DRAGEN_BASELINE_SOLID_matched_targets_v2_novaseqx.combined.counts.txt.gz --cnv-segmentation-bed resource_bundle/cnv/dragen_tso500_manifest_cnv_genes_predefined_cutoff_FFPE.bed --cnv-target-bed resource_bundle/cnv/TSO500_DRAGEN_TARGET_SOLID_matched_targets.bed --tso500-solid-msi true --msi-microsatellites-file resource_bundle/msi/references/microsatellites-TSO500-SOLID-concordant.list --msi-ref-normal-dir resource_bundle/msi/data/TSO500-