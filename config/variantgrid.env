# Shared by every VariantGrid systemd service - copied to /etc/variantgrid/variantgrid.env
#
# Where VariantGrid is installed. This is the one place the install location is set:
# the services cd here before starting, and the celery/gunicorn .env files find the
# virtual env (.venv, created by uv) relative to it.
VG_INSTALL_DIR="/opt/variantgrid"
