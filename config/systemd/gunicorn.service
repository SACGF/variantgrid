[Unit]
Description=VG web server
After=network.target

[Service]
User=variantgrid
# Both files are read, in order, and merged: variantgrid.env is shared by every VariantGrid unit and holds the
# install location (VG_INSTALL_DIR, copied from config/variantgrid.env - the one per-host setting); the second
# file is this unit's own (copied from config/gunicorn/), with paths relative to that directory.
EnvironmentFile=/etc/variantgrid/variantgrid.env
EnvironmentFile=/etc/variantgrid/gunicorn/gunicorn.env
ExecStartPre=/bin/mkdir -p /var/log/variantgrid
ExecStart=bash -c 'cd "${VG_INSTALL_DIR}" && exec ${GUNICORN_BIN} --bind 127.0.0.1:8000 -t 3600 -w 8 --pid /run/gunicorn/gunicorn.pid --log-level debug --log-file /var/log/variantgrid/gunicorn.log variantgrid.wsgi:application'
ExecReload = /bin/kill -s HUP $MAINPID
ExecStop = /bin/kill -s TERM $MAINPID
PIDFile=/run/gunicorn/gunicorn.pid
Restart=always
# Percentages are of the box's physical RAM, so the same file suits every deployment. The cap is on the
# whole unit (master + workers): a request that balloons (an unstreamed queryset over a big table) gets
# its worker OOM-killed and respawned instead of swapping the box to death. OOMPolicy=continue keeps
# that to the one worker - systemd's default (stop) would restart all of gunicorn.
MemoryHigh=40%
MemoryMax=50%
OOMPolicy=continue
PrivateTmp=true
RuntimeDirectory=gunicorn
RuntimeDirectoryMode=0750

[Install]
WantedBy=multi-user.target
