[Unit]
Description=VG Celery Beat Service
After=network.target

[Service]
Type=simple
User=variantgrid
ExecStartPre=/bin/mkdir -p /var/log/variantgrid
Restart=always
OOMPolicy=continue
# Both files are read, in order, and merged: variantgrid.env is shared by every VariantGrid unit and holds the
# install location (VG_INSTALL_DIR, copied from config/variantgrid.env - the one per-host setting); the second
# file is this unit's own (copied from config/celery/), with paths relative to that directory.
EnvironmentFile=/etc/variantgrid/variantgrid.env
EnvironmentFile=/etc/variantgrid/celery/celeryd_beat.env
ExecStart=/bin/sh -c 'cd "${VG_INSTALL_DIR}" && exec ${CELERY_BIN} -A ${CELERY_APP} beat \
  --logfile=${CELERYD_LOG_FILE} --loglevel=${CELERYD_LOG_LEVEL} ${CELERYD_OPTS}'

[Install]
WantedBy=multi-user.target
