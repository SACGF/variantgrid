# Name of nodes to start
# here we have a single node
CELERYD_NODES="celery"

# Path to the 'celery' command. This is relative to the service's WorkingDirectory
# (ie the VariantGrid install dir) so it works wherever VariantGrid is installed, eg
# /opt/variantgrid or /mnt/variantgrid. The .venv is created by uv - see the
# "Install Python venv" wiki page
CELERY_BIN=".venv/bin/celery"

# App instance to use
# comment out this line if you don't use an app
CELERY_APP="variantgrid"

# How to call manage.py
CELERYD_MULTI="multi"

# Extra command-line arguments to the worker
# Concurrency defaults to the CPU count, and an idle worker process is ~200 MB, so on a box with many
# cores and little RAM pass --concurrency=N. --max-memory-per-child (KiB) replaces a process after the
# task that took it over 2 GB: a big VCF import otherwise leaves its high-water mark resident.
CELERYD_OPTS="-n db_workers --queues=db_workers --max-memory-per-child=2097152"

# - %n will be replaced with the first part of the nodename.
# - %I will be replaced with the current child process index
#   and is important when using the prefork pool to avoid race conditions.
CELERYD_PID_FILE="/var/run/celeryd_db_workers/celeryd_%n.pid"
CELERYD_LOG_FILE="/var/log/variantgrid/%n%I.log"
CELERYD_LOG_LEVEL="INFO"
